{
  "name": "sprint-survivors",
  "version": "0.1.0",
  "private": true,
  "description": "Greentide Vanguard: survivors-like 2D para navegador (TFM, SDD + Clean Architecture).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:public": "playwright test --config playwright.remote.config.ts",
    "guard:all": "node scripts/guard-staged.mjs --all",
    "verify": "npm run lint && npm run typecheck && npm run guard:all && npm run test",
    "lint:fast": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test:fast": "vitest run --changed --exclude tests/domain/balance.test.ts",
    "verify:fast": "npm run lint:fast && npm run typecheck && npm run test:fast",
    "prepare": "husky",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.json": "prettier --write"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
